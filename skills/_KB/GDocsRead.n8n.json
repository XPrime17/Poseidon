          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Google Docs account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const doc = $input.first().json;\nconst body = doc.body || {};\nconst content = (body.content || []).map(el => {\n  if (el.paragraph) {\n    return (el.paragraph.elements || []).map(e => e.textRun?.content || '').join('');\n  }\n  return '';\n}).join('');\n\nreturn [{\n  json: {\n    title: doc.title || 'Untitled',\n    content: content.trim(),\n    lastModified: new Date().toISOString()\n  }\n}];"
      },
      "id": "code-extract-node",
      "name": "Extract Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    }
